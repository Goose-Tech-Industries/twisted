# =================================================================
# Twisted Engine — Next.js UI .env.local (ui/.env.local)
# Copy this file to .env.local before running the UI.
# =================================================================

# ── Local Development ─────────────────────────────────────────────
# In dev, the Next.js proxy rewrites in next.config.mjs handle routing
# API calls from :3000 → :3001. So API_URL is blank (same-origin).
# SOCKET_URL must point directly to the backend for WebSocket.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── Production ────────────────────────────────────────────────────
# In production, nginx proxies both UI and API on the same domain.
# Both values should be blank (same-origin):
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=
