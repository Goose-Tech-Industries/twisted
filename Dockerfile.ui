#################################################
# Twisted Engine — Player UI (SvelteKit + PixiJS)
#################################################

# ── Build stage ────────────────────────────────
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy monorepo workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/ packages/
COPY player/ player/

# Install dependencies across workspace
RUN pnpm install --frozen-lockfile

# Build player (SvelteKit adapter-node)
RUN pnpm --filter @twisted/player build

# ── Production stage ───────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=builder /app/player/build ./build
COPY --from=builder /app/player/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/player/node_modules ./player/node_modules

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "build/index.js"]
