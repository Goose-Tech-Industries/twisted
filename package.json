{
  "name": "twisted-engine-monorepo",
  "version": "23.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:player\" --names \"backend,player\" --prefix-colors \"cyan,green\"",
    "dev:backend": "cd te_phoenix && mix phx.server",
    "dev:player": "pnpm --filter @twisted/player dev",
    "test:backend": "cd te_phoenix && mix test",
    "build:player": "pnpm --filter @twisted/player build",
    "start:prod": "pm2 start ecosystem.player.config.js",
    "stop:prod": "pm2 stop ecosystem.player.config.js",
    "restart:prod": "pm2 restart ecosystem.player.config.js",
    "logs": "pm2 logs",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup-db.sh",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
