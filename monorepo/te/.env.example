# =================================================================
# Twisted Engine — Environment Configuration
# Copy this to .env and fill in every value marked REQUIRED.
#
# Generate SESSION_SECRET with:
#   npm run generate-secret   (from monorepo root)
# =================================================================

# ── Core ─────────────────────────────────────────────────────────
PORT=3001

# ── Database (REQUIRED) ───────────────────────────────────────────
DB_HOST=localhost
DB_USER=twisted_user          # REQUIRED: not root in production
DB_PASS=CHANGE_ME_LONG_RANDOM # REQUIRED: not blank, not "password"
DB_NAME=twisted_rpg

# ── Session security (REQUIRED) ───────────────────────────────────
# Must be a long random string. Run: npm run generate-secret
SESSION_SECRET=CHANGE_ME_RUN_npm_run_generate-secret

# ── CORS + cookies ────────────────────────────────────────────────
# Set to the EXACT origin your users browse from (no trailing slash).
# In production this MUST be set — "allow all" is not acceptable.
# Example: ALLOWED_ORIGIN=https://twistedengine.com
ALLOWED_ORIGIN=http://localhost:3000

# In production, also set:
# NODE_ENV=production
# (enables: trust proxy, secure cookies, sameSite:lax, access log file)

# ── Logging ───────────────────────────────────────────────────────
# Directory for access.log and error logs (created automatically)
# LOG_DIR=./logs

# ── AI — NPC Dialogue (optional) ─────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# NPC_LLM_URL=http://localhost:11434/api/generate

# ── Spotify (optional) ────────────────────────────────────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://yourdomain.com/api/spotify/callback

# ── Email verification (optional) ─────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Twisted Engine <you@gmail.com>
# GAME_URL=https://yourdomain.com
# REQUIRE_EMAIL_VERIFY=true

# =================================================================
# PRODUCTION LAUNCH CHECKLIST
# Tick every box before going live:
# =================================================================
# [ ] SESSION_SECRET is a 64-char random string (npm run generate-secret)
# [ ] DB_PASS is not blank and not a dictionary word
# [ ] DB_USER is not root (create a restricted MySQL user)
# [ ] ALLOWED_ORIGIN is set to your exact production domain
# [ ] NODE_ENV=production is set in your process environment (PM2 env)
# [ ] HTTPS is configured in nginx (certbot --nginx)
# [ ] Backup cron is scheduled: 0 3 * * * bash /var/www/twisted/scripts/backup-db.sh
# [ ] You have tested: npm run backup && gunzip -t backups/*.gz
# [ ] PM2 startup hook saved: pm2 save && pm2 startup
# [ ] /health returns {"status":"ok"} from your production domain
# [ ] A staff user has been set: UPDATE users SET role='ADMIN' WHERE username='you';
